rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isShopAdmin(shopId) {
      let membership = /databases/$(database)/documents/shops/$(shopId)/users/$(request.auth.uid);
      return signedIn()
        && exists(membership)
        && get(membership).data.active == true
        && get(membership).data.role == "admin";
    }

    match /shops/{shopId} {
      allow read, write: if isShopAdmin(shopId);

      match /users/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list, create, update, delete: if false;
      }

      match /products/{productId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /categories/{categoryId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /sales/{saleId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /inventoryMovements/{movementId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /suppliers/{supplierId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /purchases/{purchaseId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /customers/{customerId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /expenses/{expenseId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /settings/{settingId} {
        allow read, write: if isShopAdmin(shopId);
      }
      match /counters/{counterId} {
        allow read, write: if isShopAdmin(shopId);
      }
    }
  }
}
